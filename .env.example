# ─────────────────────────────────────────────────────────────────────────────
# Sahynex OS — environment variables (placeholders only; never commit real values)
# Copy to .env for local development. In production use your platform's secret manager.
# ─────────────────────────────────────────────────────────────────────────────

# Core (required)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/sahynex
DATABASE_SSL=false                 # true for managed Postgres that requires TLS
DATABASE_POOL_MAX=10
SESSION_SECRET=replace-with-64-random-characters   # openssl rand -base64 48
APP_URL=https://os.example.com     # public URL, used in emails and webhook setup text
APP_TIMEZONE=Asia/Kolkata          # interpretation of date-time form fields

# Organisation bootstrap (npm run db:bootstrap)
ORG_NAME=Sahynex TechSolutions Pvt. Ltd.
ORG_SLUG=sahynex
ORG_TIMEZONE=Asia/Kolkata
ORG_CURRENCY=INR
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_PASSWORD=                    # 10+ chars, mixed character types; change after first sign-in

# File storage (local driver writes to a persistent, backed-up volume)
STORAGE_DRIVER=local
STORAGE_DIR=/var/lib/sahynex/storage

# Worker
WORKER_TICK_MS=5000
CRON_SECRET=                       # only if using /api/cron/tick instead of the long-running worker (24+ chars)

# Security tuning (optional)
LOGIN_RATE_LIMIT_IP=30             # sign-in attempts per IP per 15 minutes
LOGIN_RATE_LIMIT_EMAIL=10          # sign-in attempts per email per 15 minutes
MONITOR_ALLOW_PRIVATE=false        # never true in production (allows monitoring internal addresses)

# Email (optional — reports and alerts are delivered in-app without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sahynex OS <no-reply@example.com>

# Meta Marketing API (Ads Insights) — see docs/INTEGRATIONS.md
META_ACCESS_TOKEN=
META_GRAPH_VERSION=                # e.g. the current version from the Graph API changelog
# Meta Lead Ads webhook
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Google (Ads API + GA4 Data API)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=            # e.g. a currently supported version from the Google Ads API release notes
GA4_REFRESH_TOKEN=

# n8n / Make outbound webhooks
N8N_WEBHOOK_SECRET=

# WhatsApp Business Platform (Cloud API) — permanent System User token with whatsapp_business_messaging.
# Uses META_GRAPH_VERSION above. Phone number ID and approved templates are set in Settings → Integrations.
WHATSAPP_ACCESS_TOKEN=

# Home page briefing (each is optional; the Home page shows a "connect" state until set)
# Google (Gmail + Calendar, read-only, each person connects their own account) uses the shared
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET above and APP_URL for the redirect URI.
INSTAGRAM_ACCESS_TOKEN=             # long-lived Page token with instagram_basic (uses META_GRAPH_VERSION)
ANTHROPIC_API_KEY=                  # AI daily brief
AI_MODEL=                           # optional, default claude-sonnet-5-5
AI_WEB_SEARCH=false                 # true lets the brief look up current trends (extra cost per search)
TOKEN_ENCRYPTION_KEY=               # optional; encrypts stored Google tokens (defaults to SESSION_SECRET)

# Development only
SEED_DEMO=false
DEMO_PASSWORD=
