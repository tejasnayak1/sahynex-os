{
  "name": "sahynex-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docs:gen": "DATABASE_URL=${DATABASE_URL:-postgres://unused/unused} tsx scripts/gen-docs.ts",
    "test:all": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@date-fns/tz": "1.4.1",
    "@node-rs/argon2": "2.0.2",
    "clsx": "2.1.1",
    "cron-parser": "5.4.0",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "0.548.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "papaparse": "5.5.3",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.16",
    "@types/node": "22.18.12",
    "@types/nodemailer": "8.0.2",
    "@types/papaparse": "5.3.16",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "0.31.5",
    "eslint": "9.38.0",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.16",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
